---
/**
 * The editorial article shell: the purple gradient band, a centered hero, and
 * a rounded content card holding the prose beside a sticky table of contents.
 */
import SiteLayout from '~/layouts/SiteLayout.astro';
import '~/styles/prose.css';

interface Props {
  title: string;
  description?: string | undefined;
  /**
   * The prose's `h2`s, which become the contents list. An empty list drops
   * the nav entirely rather than rendering an empty one.
   */
  sections?: { slug: string; text: string }[] | undefined;
  /** Passed through to `MainLayout`, which documents it. */
  preloadCodeFont?: boolean | undefined;
}

const { title, description, sections = [], preloadCodeFont } = Astro.props;
---

<SiteLayout
  title={title}
  description={description}
  headerOverlay
  {preloadCodeFont}
>
  <article>
    <div class="hero">
      <div class="hero-inner wrapper">
        <slot name="hero" />
      </div>
    </div>

    <div class="panel">
      {/*
        `has-toc` so the second column exists only when something fills it: an
        empty track still grows to its growth limit, which would leave the
        prose off-center on a page with no sections.
      */}
      <div class:list={['panel-inner', { 'has-toc': sections.length > 0 }]}>
        {/*
          Written before the prose so that the default layout, which stacks the
          contents above the article, agrees with the reading and tab order.
          Wide viewports place it in the second column instead.
        */}
        {sections.length > 0 && (
          <nav class="toc" aria-labelledby="toc-heading">
            <p class="toc-heading" id="toc-heading">
              Table of Contents
            </p>
            <ol class="toc-list" role="list">
              {sections.map(({ slug, text }) => (
                <li>
                  <a href={`#${slug}`}>{text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  article {
    /* The gradient's last stop, continued flat below its extent. */
    --gradient-end: #210340;

    background-color: var(--gradient-end);
    background-image: radial-gradient(
      97.33rem 54.5625rem ellipse at 50% -16.90625rem,
      #ae49ec 0%,
      #8b38c1 25%,
      #682696 50%,
      #44156b 75%,
      #330c56 87.5%,
      var(--gradient-end) 100%
    );
    background-repeat: no-repeat;
  }

  /*
   * Hero — Figma node `42:1663`. Pins `color-scheme: dark` so the tag and
   * headline read --color-heading the normal way round rather than carrying
   * a second set of values; the header above it does the same, via
   * `headerOverlay`.
   */
  .hero {
    color-scheme: dark;
    color: var(--color-heading);
  }

  /*
   * Parallax scroll the hero.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        animation: hero-parallax linear both;
        /* After the shorthand, which resets animation-timeline. */
        animation-timeline: view();
        animation-range: exit-crossing;
      }
    }
  }

  @keyframes hero-parallax {
    to {
      translate: 0 50%;
    }
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    /* 30 between the tag and the headline; the date's own margin adds the
       remainder of the 60 below it. */
    gap: var(--space-30);
    /* Clears the header, which overlaps this row. */
    padding-block: 10.1875rem var(--space-80);
    text-align: center;
  }

  /*
   * Content panel — Figma node `42:1616`. A rounded card that rises over the
   * gradient and runs to the foot of the article.
   */
  .panel {
    /* Allow it to sit on top of the hero's parallax effect. */
    position: relative;
    z-index: 1;

    /* The container `--column-side` below is measured against. It has to be
       this element rather than the one that declares that value, since an
       element cannot query its own container — and measuring here also means
       the width being read cannot depend on anything the value goes on to
       affect. */
    container: panel / inline-size;

    /* Narrow enough that the gutter costs more than the inset is worth: the
       card goes full-bleed and its sides meet the viewport, leaving the
       corners to mark the top edge on their own. */
    margin-inline: 0;
    border-start-start-radius: 1.5rem;
    border-start-end-radius: 1.5rem;
    background-color: var(--color-background-main);
    box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 0.15);

    /* The design's 48 radius is drawn for a 1408-wide card; it only stops
       eating a noticeable share of the width once the card is this wide. */
    @media (width >= 48rem) {
      border-start-start-radius: 3rem;
      border-start-end-radius: 3rem;
    }

    /* Room for the inset: the gutter is carved out of the page cap, so the
       card sits inside it on both sides rather than running full-bleed. */
    @media (width >= 51rem) {
      margin-inline: var(--gutter);
    }
  }

  .panel-inner {
    /* The track sizes, named because the side padding below is derived from
       the same numbers the grid is built from. The prose column is capped at
       the design's 43.5rem throughout; the other two are zero until the TOC
       moves alongside. */
    --prose-width: 43.5rem;
    --toc-width: 0rem;
    --column-gap: 0rem;

    /*
     * The space either side of the columns, computed rather than left as free
     * space for `justify-content: center` to absorb. A breakout needs to know
     * how far it may reach to escape its column, and free space is not a
     * length anything can read. Registered in `tokens.css`, which is what
     * makes the `100cqi` measure `.panel` here rather than `.prose` at the
     * use site.
     */
    --column-side: max(
      var(--panel-inset),
      calc(
        (100cqi - var(--prose-width) - var(--column-gap) - var(--toc-width)) / 2
      )
    );

    /* How far a breakout may pull out on each side, which is symmetrical
       until the TOC takes the end side. */
    --breakout-start: var(--column-side);
    --breakout-end: var(--column-side);

    display: grid;
    /* Too narrow for the TOC to sit beside the prose, so it stacks above —
       which is also its markup order. */
    grid-template-areas:
      'toc'
      'prose';
    grid-template-columns: minmax(0, var(--prose-width));
    padding-inline: var(--column-side);
    row-gap: var(--space-40);
    padding-block: var(--space-40) var(--space-80);

    /* Room for the TOC's 13.8125rem beside the prose, with the pair centered
       in the card. The areas put the TOC second visually even though it comes
       first in the markup. */
    @media (width >= 75rem) {
      padding-block-start: 7.5rem;

      &.has-toc {
        --toc-width: 13.8125rem;
        --column-gap: var(--space-80);
        /* The column sits off-center in the card once the TOC is beside it,
           so a breakout reaches further on this side — across the gap and the
           TOC both, which is what puts it at the card's edge. */
        --breakout-end: calc(
          var(--column-side) + var(--column-gap) + var(--toc-width)
        );

        grid-template-areas: 'prose toc';
        grid-template-columns:
          minmax(0, var(--prose-width))
          minmax(0, var(--toc-width));
        column-gap: var(--column-gap);
      }
    }
  }

  .prose {
    grid-area: prose;
  }

  /*
   * Table of contents
   */
  .toc {
    grid-area: toc;
    display: grid;
    gap: var(--space-12);
    align-content: start;
    font-size: var(--text-label-xs-caps);
    font-weight: 500;
    line-height: var(--leading-body);
    text-box: trim-both cap alphabetic;
  }

  .toc-heading {
    color: var(--color-purple);
    text-box: trim-both cap alphabetic;

    /* Decorative, and this heading is the nav's accessible name, so the
       slashes are drawn rather than written — as in prose.css's `// 01`. */
    &::before {
      content: '// ';
    }
  }

  .toc-list {
    display: grid;
    gap: var(--space-12);
    /* The numbers hang in their own column so the labels align. */
    counter-reset: toc;

    & li {
      display: grid;
      grid-template-columns: 1rem 1fr;
      gap: var(--space-8);
      counter-increment: toc;

      &::before {
        content: counter(toc, decimal-leading-zero);
        color: var(--color-link-purple);
        text-box: trim-both cap alphabetic;
      }
    }

    & a {
      color: var(--color-heading);
      line-height: 1.25;
      text-decoration: none;
      text-box: trim-both cap alphabetic;

      &:hover {
        text-decoration: underline;
      }
    }
  }
</style>
