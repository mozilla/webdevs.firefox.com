---
/**
 * Site footer. The "Which version of Firefox is right for me?" CTA that sits
 * above this in the design is intentionally not included yet.
 */
const linkColumns = [
  {
    heading: 'Follow Us',
    links: [
      {
        label: 'BlueSky',
        href: 'https://bsky.app/profile/webdevs.firefox.com',
      },
      { label: 'Mastodon', href: 'https://mastodon.social/@firefoxwebdevs' },
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/showcase/firefox-web-developers/',
      },
      { label: 'X', href: 'https://x.com/FirefoxWebDevs' },
      { label: 'YouTube', href: 'https://www.youtube.com/@FirefoxWebDevs' },
      { label: 'TikTok', href: 'https://www.tiktok.com/@firefoxwebdevs' },
      { label: 'Threads', href: 'https://www.threads.com/@firefoxwebdevs' },
      {
        label: 'Instagram',
        href: 'https://www.instagram.com/firefoxwebdevs/reels/',
      },
    ],
  },
  {
    heading: 'Firefox Essentials',
    links: [
      { label: 'RSS', href: '/rss.xml' },
      { label: 'MDN', href: 'https://developer.mozilla.org/' },
      {
        label: 'DevTools',
        href: 'https://firefox-source-docs.mozilla.org/devtools-user/',
      },
      { label: 'Addons', href: 'https://addons.mozilla.org/' },
      { label: 'Spidermonkey updates', href: 'https://spidermonkey.dev/' },
      {
        label: 'Security blog',
        href: 'https://blog.mozilla.org/security/',
      },
      {
        label: 'Nightly blog',
        href: 'https://blog.nightly.mozilla.org/',
      },
    ],
  },
];

const legalLinks = [
  {
    label: 'Website Privacy Notice',
    href: 'https://www.mozilla.org/privacy/websites/',
  },
  {
    label: 'Terms of Use',
    href: 'https://www.mozilla.org/about/legal/terms/firefox/',
  },
  {
    label: 'Cookie Policy',
    href: 'https://www.firefox.com/privacy/websites/cookie-settings/',
  },
  {
    label: 'Community Participation Guidelines',
    href: 'https://www.mozilla.org/about/governance/policies/participation/',
  },
  {
    label: 'Logo Trademark Licensing',
    href: 'https://www.mozilla.org/foundation/trademarks/policy/',
  },
];
---

<footer class="footer">
  <div class="footer-inner wrapper">
    <div class="columns">
      {
        linkColumns.map(({ heading, links }) => (
          <section class="column">
            <h2 class="column-heading">{heading}</h2>
            <ul class="link-list" role="list">
              {links.map(({ label, href }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <section class="column mozilla">
        <h2 class="column-heading">Powered by Mozilla</h2>
        <p>
          <a href="https://connect.mozilla.org/">Ask Us a Question!</a>
        </p>
      </section>
    </div>

    <nav class="legal" aria-label="Legal">
      <ul class="legal-list" role="list">
        {
          legalLinks.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    /* The footer uses dark mode regardless */
    color-scheme: dark;
    background-color: var(--color-background-main);
    color: var(--color-heading);

    & a {
      color: inherit;
      font-size: var(--text-body-xs);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .footer-inner {
    display: grid;
    gap: var(--space-40);
    padding-block: var(--space-32);
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: start;
    gap: var(--space-32);

    /* Wide enough for two columns side by side. */
    @media (width >= 27.1rem) {
      grid-template-columns: auto auto;
      column-gap: var(--space-40);
    }

    /* Wide enough for all three. */
    @media (width >= 64rem) {
      grid-template-columns: auto auto 1fr;
      column-gap: var(--space-32);
    }
  }

  .column {
    display: grid;
    align-content: start;
    gap: var(--space-16);
  }

  .column-heading {
    font-size: var(--text-body-sm);
    font-weight: 700;
  }

  .link-list {
    /* Narrow: one run of links. */
    display: grid;
    align-content: start;
    gap: var(--space-12);

    @media (width >= 48rem) {
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      grid-auto-columns: minmax(10rem, auto);
      column-gap: var(--space-16);
    }
  }

  .mozilla {
    gap: 0;

    @media (width >= 64rem) {
      justify-self: end;
      margin-inline-end: 7rem;
    }

    & .column-heading,
    & p {
      font-size: 0.75rem;
      line-height: 1.4;
    }

    & a {
      font-size: inherit;
    }
  }

  .legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-0) var(--space-16);

    & a {
      font-size: 0.625rem;
      font-weight: 500;
      line-height: var(--leading-label-xs-caps);
      letter-spacing: 0.02em;
    }
  }
</style>
