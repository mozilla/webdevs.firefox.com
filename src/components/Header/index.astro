---
import Button from '~/components/Button';
import logo from '~/assets/logos/firefox.svg';
import Wordmark from './assets/firefox-wordmark.svg';

/** Primary nav, split either side of a divider as in the design. */
const primaryLinks = [
  { label: 'Blog', href: '/blog/' },
  { label: 'Release notes', href: '/release-notes/' },
  { label: 'Experiments', href: '/experiments/' },
];

const externalLinks = [
  { label: 'MDN', href: 'https://developer.mozilla.org/' },
  {
    label: 'DevTools',
    href: 'https://firefox-source-docs.mozilla.org/devtools-user/',
  },
  { label: 'Addons', href: 'https://addons.mozilla.org/' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header-inner wrapper">
    <a class="brand" href="/">
      <img
        class="brand-logo"
        src={logo.src}
        alt=""
        decoding="async"
        width={logo.width}
        height={logo.height}
      />
      <span class="brand-text">
        <Wordmark
          class="brand-wordmark"
          role="img"
          aria-label="Firefox"
          width={94}
          height={21}
        />
        <span class="brand-suffix">
          for Web Dev<span class="brand-suffix-full">eloper</span>s
        </span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list" role="list">
        {
          primaryLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={currentPath.startsWith(href) ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li role="separator" class="nav-divider"></li>
        {
          externalLinks.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button class="cta" size="compact" href="https://www.firefox.com/">
      Get Firefox
    </Button>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-background-main);
  }

  .header-inner {
    /* Mobile: brand and CTA share the first row, the nav takes the second. */
    display: grid;
    grid-template-areas:
      'brand cta'
      'nav nav';
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: var(--space-24);
    row-gap: var(--space-12);
    padding-block: 1.25rem;

    /* Wide enough for the full nav to fit beside the brand. */
    @media (width >= 65rem) {
      grid-template-areas: 'brand nav cta';
      grid-template-columns: auto 1fr auto;
      row-gap: var(--space-0);
    }
  }

  .brand {
    grid-area: brand;
    display: grid;
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: var(--space-12);
    text-decoration: none;
  }

  .brand-logo {
    width: 2.5rem;
    height: 2.5rem;
  }

  .brand-text {
    display: grid;
    /* Stacked by default: the wordmark sits above the suffix, both flush to
       the inline start so they share an edge rather than a baseline. */
    justify-items: start;
    gap: var(--space-8);

    /* Wide enough for "for Web Devs" to sit beside the wordmark. */
    @media (width >= 32rem) {
      grid-auto-flow: column;
      /* This aligns to the baseline - since the wordmark has no descender
         and the suffix is trimmed to the alphabetic baseline */
      align-items: end;
      gap: 0.53em;
    }
  }

  .brand-wordmark {
    width: auto;
    height: 1.3125rem;
    /* The wordmark paths are fill="currentColor" so it follows the scheme. */
    color: var(--color-heading);
  }

  .brand-suffix {
    color: var(--color-heading);
    /* Trimmed in the design, so the text sits optically on the logo. */
    text-box: trim-both cap alphabetic;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;

    @media (width >= 32rem) {
      font-size: 1.75rem;
    }
  }

  /* Hiding the middle of "Developers" shortens it to "Devs", so the wording
     is only written once. */
  .brand-suffix-full {
    display: none;

    /* Wide enough to spell out "Developers". */
    @media (width >= 40rem) {
      display: revert;
    }
  }

  .nav {
    grid-area: nav;
    justify-self: start;

    @media (width >= 65rem) {
      justify-self: end;
    }
  }

  .nav-list {
    /* Flex, not grid: the link count is variable and these need to wrap. */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-16);

    & a {
      color: var(--color-heading);
      text-box: trim-both cap alphabetic;
      font-size: var(--text-label-xs-caps);
      line-height: var(--leading-body-xs);
      text-decoration: none;
      white-space: nowrap;

      &:hover {
        text-decoration: underline;
      }

      &[aria-current='page'] {
        font-weight: 600;
      }
    }
  }

  .nav-divider {
    /* On the narrow layout the two link groups can end up on separate rows,
       where the rule between them reads as a stray mark. */
    display: none;
    align-self: stretch;
    width: 0.0625rem;
    min-height: 1.125rem;
    background-color: var(--color-border);

    @media (width >= 30rem) {
      display: revert;
    }
  }

  /* Placement only — the button's own styling lives in Button.module.css. */
  .cta {
    grid-area: cta;
  }
</style>
