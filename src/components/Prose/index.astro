---
/**
 * Renders an MDX document's body with the components markdown maps to.
 *
 * Markdown syntax that has a component behind it is mapped here, so a page
 * renders `<Prose {Content} />` and gets the mapping with it. The alternative
 * is passing a `components` object at every `<Content />` call site, which
 * Astro has no global equivalent for — one copy per page, each able to fall
 * quietly behind the others.
 *
 * The `.prose` wrapper and its placement belong to whatever lays the page out
 * (`ArticleLayout` for both current call sites), so this adds no element of
 * its own — it is the mapping, not a container.
 *
 * This mapping is what lets a construct's styles live with its component
 * rather than in `prose.css`: the component becomes what authored markdown
 * renders as, not an alternative to it, so there is no second code path to
 * keep in step. `prose.css` keeps the elements that have no component —
 * headings, lists, tables, code — and the spacing that runs between blocks.
 *
 * Anything added to `components` must render the element it replaces, and
 * reach its markdown-generated descendants through `:global()`: Astro's scope
 * hash lands on a component's root element and never on children that came
 * from markdown.
 */
import type { MarkdownInstance } from 'astro';

import Blockquote from '~/components/Blockquote';

interface Props {
  /** The `Content` component from a rendered MDX entry. */
  Content: MarkdownInstance<Record<string, unknown>>['Content'];
}

const { Content } = Astro.props;
---

{/*
  `astro-eslint-parser` cannot resolve an `.astro` default import, so
  `Blockquote` is error-typed here and the mapping reads as an unsafe
  assignment. `astro check` and `tsc` both resolve it through the `~/*` alias
  and pass, so the type is fine and only this one rule is silenced.
*/}
{/* eslint-disable-next-line @typescript-eslint/no-unsafe-assignment -- see above */}
<Content components={{ blockquote: Blockquote }} />
