---
/**
 * The hero's contents for an editorial article — Figma node `42:1663`: a
 * pill-shaped tag, the headline, and an optional byline beneath it.
 *
 * Separate from `ArticleLayout` because these three are slotted into it, and
 * Astro's scoped styles do not reach a parent's slotted markup — the styles
 * have to travel with the elements they describe. The layout owns the hero's
 * grid and dark `color-scheme`; this owns the type.
 */
interface Props {
  /** The pill above the headline, e.g. "Release". */
  tag?: string | undefined;
}

const { tag } = Astro.props;
---

{tag && <p class="tag">{tag}</p>}
<h1>
  <slot />
</h1>
{Astro.slots.has('byline') && (
  <p class="byline">
    <slot name="byline" />
  </p>
)}

<style>
  .tag {
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-white-fixed);
    color: var(--color-black-fixed);
    font-size: var(--text-label-xs-caps);
    font-weight: 600;
    text-box: trim-both cap alphabetic;
  }

  h1 {
    max-width: 43.5rem;
    /* 72 with -2.16 tracking: a local style in the design, not title-lg. */
    font-family: var(--font-mozilla-headline);
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-box: trim-both cap alphabetic;

    @media (width >= 48rem) {
      font-size: 4.5rem;
    }
  }

  .byline {
    /* Doubles with the hero's grid gap above to make the design's 60. */
    margin-block-start: var(--space-30);
    font-size: var(--text-label-xs-caps);
    font-weight: 500;
    letter-spacing: var(--tracking-label-xs-caps);
    text-transform: uppercase;
    text-box: trim-both cap alphabetic;
  }
</style>
