---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import ArticleLayout from '~/layouts/ArticleLayout.astro';
import ArticleHero from '~/components/ArticleHero';
import { releaseNote } from './_release-note';

/**
 * One page per release note, at `/release-notes/[year]/[version]/`.
 */
export const getStaticPaths = (async () => {
  const notes = await getCollection('releaseNotes');
  return notes.map((entry) => {
    const { year, version } = releaseNote(entry);
    return { params: { year, version }, props: { entry } };
  });
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'releaseNotes'>;
}

const { entry } = Astro.props;
const { title, releaseDate } = releaseNote(entry);
const { Content, headings } = await render(entry);

/** The h2s are the page's sections, and the numbering matches prose.css. */
const sections = headings.filter(({ depth }) => depth === 2);

const formattedDate = releaseDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

{/*
  Release notes always contain code, so preloading is worth it.
*/}
<ArticleLayout title={title} sections={sections} preloadCodeFont>
  <ArticleHero slot="hero" tag="Release">
    {title}
    <time slot="byline" datetime={releaseDate.toISOString().slice(0, 10)}>
      {formattedDate}
    </time>
  </ArticleHero>

  <Content />
</ArticleLayout>
