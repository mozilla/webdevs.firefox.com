---
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import ArticleHero from '~/components/ArticleHero';
import { testPagePaths } from '~/pages/_test/_test-pages';

/**
 * Overlay header specimen, at `/test/header-overlay/` — the header as it
 * appears over an article's hero.
 *
 * `ArticleLayout` with `headerOverlay`, which is the real thing rather than
 * an approximation of it: the header pins itself to the dark scheme for
 * legibility over that gradient, and the gradient is `ArticleLayout`'s own
 * six-stop radial. A stand-in drawn here would be what the baseline
 * recorded, so a change to the real gradient would not show up.
 *
 * Deliberately short — one heading and nothing else — so the shot is the
 * header, the hero and their overlap, and does not duplicate what
 * `/test/prose/` already covers below the fold.
 */
export const getStaticPaths = testPagePaths;
---

<ArticleLayout title="Overlay header specimen">
  <ArticleHero slot="hero" tag="Test">
    Overlay header
    <Fragment slot="byline">Header over the article hero</Fragment>
  </ArticleHero>

  <p>
    The header above pins itself to the dark scheme so it stays legible over the
    hero gradient. This paragraph is here only to give the content card
    something to hold.
  </p>
</ArticleLayout>
