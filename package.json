{
  "name": "webdevs.firefox.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "astro dev --force",
    "lint": "eslint .",
    "test": "node --test \"lib/**/*.test.ts\" \"tests/visual/**/*.test.ts\"",
    "vrt": "node tests/visual/runner/docker.ts \"node tests/visual/runner/run.ts\"",
    "vrt:prerelease": "VRT_TIER=prerelease node tests/visual/runner/docker.ts \"node tests/visual/runner/run.ts\"",
    "vrt:accept": "node tests/visual/runner/accept.ts",
    "vrt:accept:prerelease": "VRT_TIER=prerelease node tests/visual/runner/accept.ts",
    "vrt:report": "npx playwright show-report .vrt/stable/report",
    "vrt:report:prerelease": "npx playwright show-report .vrt/prerelease/report",
    "vrt:shell": "node tests/visual/runner/docker.ts shell",
    "check": "pnpm run format:check; INCLUDE_TEST_PAGES=1 pnpm run build; pnpm run lint; pnpm run test",
    "build": "astro build && astro check && tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:release-notes": "node lib/release-notes/import.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/preact": "^6.0.5",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "astro": "^7.3.2",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "preact": "^10.29.8",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "satteri": "0.10.5",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
